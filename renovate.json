{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackagePatterns": [
        "notify_push"
      ],
      "groupName": "notify_push",
      "versioning": "semver"
    },
    {
      "matchPaths": [
        "notify_push/Dockerfile"
      ],
      "matchPackageNames": [
        "notify_push"
      ],
      "enabled": true,
      "automerge": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nginx"
      ],
      "allowedVersions": "1.30.*"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "redis"
      ],
      "allowedVersions": "8.*"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mariadb"
      ],
      "allowedVersions": "12.3.*"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nextcloud"
      ],
      "allowedVersions": "35.*"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/nextcloud/nextcloud-appapi-harp"
      ],
      "automerge": false
    }
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "notify_push/Dockerfile"
      ],
      "matchStrings": [
        "NOTIFY_PUSH_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "nextcloud/notify_push",
      "versioningTemplate": "semver"
    }
  ]
}
